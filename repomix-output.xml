<file path="src/store.ts">
import { create } from 'zustand';

export interface Message {
  role: 'user' | 'ai' | 'system';
  content: string;
}

export interface ChapterNode {
  id: string;
  title: string;
  challenge: string;
  context: string;
  fullText?: string; // Propiedad para almacenar el texto original del libro
}

interface AppState {
  activeChapter: ChapterNode | null;
  messages: Message[];
  setActiveChapter: (chapter: ChapterNode) => void;
  addMessage: (message: Message) => void;
  clearMessages: () => void;
}

export const useAppStore = create<AppState>((set) => ({
  activeChapter: null,
  messages: [],
  
  // Al cambiar de capítulo, establecemos el nuevo reto y limpiamos el chat anterior
  setActiveChapter: (chapter) => set({ 
    activeChapter: chapter,
    messages: [] 
  }),
  
  // Añade un nuevo mensaje al historial de la conversación actual
  addMessage: (message) => set((state) => ({ 
    messages: [...state.messages, message] 
  })),
  
  // Limpia manualmente el historial de mensajes
  clearMessages: () => set({ 
    messages: [] 
  }),
}));
