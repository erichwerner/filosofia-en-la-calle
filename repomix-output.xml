import { useState } from 'react';
import type { FormEvent } from 'react';
import { useAppStore } from './store';
import type { ChapterNode } from './store';
import { CHAPTER_NODES } from './data/chapters';
import LectorVoz from './components/LectorVoz';
import TextoEnriquecido from './components/TextoEnriquecido';
import ModalReferencia from './components/ModalReferencia';
import type { TerminoGlosario } from './data/glosario';

export default function PhilosophyChatApp() {
  const { activeChapter, messages, setActiveChapter, addMessage } = useAppStore();
  const [inputValue, setInputValue] = useState('');
  const [showText, setShowText] = useState(false);
  // Estado para controlar qué tarjeta del glosario está abierta
  const [referenciaAbierta, setReferenciaAbierta] = useState<TerminoGlosario | null>(null);

  const handleSendMessage = async (e: FormEvent) => {
    e.preventDefault();
    if (!inputValue.trim() || !activeChapter) return;

    addMessage({ role: 'user', content: inputValue });
    setInputValue('');

    setTimeout(() => {
      addMessage({ 
        role: 'ai', 
        content: "Resulta intrigante tu pragmatismo. Sin embargo, al observar las premisas de este capítulo, nos vemos obligados a cuestionar: ¿Acaso esa decisión no erosiona el tejido de tu propia identidad, dejándote a merced de una moralidad líquida?" 
      });
    }, 1200);
  };

  const handleChapterChange = (node: ChapterNode) => {
    setActiveChapter(node);
    setShowText(false);
    setReferenciaAbierta(null); // Cierra cualquier tarjeta abierta si el usuario cambia de capítulo
  };

  return (
    <div 
      className="flex h-screen font-sans overflow-hidden bg-cover bg-center"
      style={{ backgroundImage: "url('/filosofía en la calle imagen.png')" }}
    >
      
      <aside className="w-80 lg:w-96 bg-ink text-parchment flex flex-col h-full shadow-2xl z-20 relative border-r-4 border-ink-light">
        <div className="p-10 pb-8 border-b border-white/10 relative">
          <div className="absolute top-0 left-0 w-full h-1 bg-crimson"></div>
          <h1 className="text-3xl font-display font-semibold tracking-wide text-white">Filosofía <br/>en la Calle</h1>
          <p className="text-xs font-sans tracking-[0.2em] text-parchment-dark mt-4 uppercase opacity-70">Debates Contemporáneos</p>
        </div>
        
        <div className="flex-1 overflow-y-auto p-6 space-y-3">
          {CHAPTER_NODES.map((node) => (
            <button
              key={node.id}
              onClick={() => handleChapterChange(node)}
              className={`w-full text-left p-5 rounded-sm transition-all duration-300 group relative overflow-hidden ${
                activeChapter?.id === node.id 
                  ? 'bg-white/10 border border-white/20 shadow-inner' 
                  : 'hover:bg-white/5 border border-transparent'
              }`}
            >
              {activeChapter?.id === node.id && (
                <div className="absolute left-0 top-0 bottom-0 w-1 bg-crimson"></div>
              )}
              <div className={`font-display text-lg mb-2 transition-colors ${activeChapter?.id === node.id ? 'text-white' : 'text-parchment group-hover:text-white'}`}>
                {node.title}
              </div>
              <div className="text-sm font-serif italic text-parchment-dark line-clamp-2 leading-relaxed opacity-80">
                "{node.challenge}"
              </div>
            </button>
          ))}
        </div>
      </aside>

      <main className="flex-1 flex flex-col relative h-full bg-parchment/80 backdrop-blur-[3px]">
        {activeChapter ? (
          <>
            <header className="px-12 py-14 lg:px-24 border-b border-stone-300/30 flex-shrink-0 bg-parchment/90 backdrop-blur-md z-10 relative shadow-sm flex justify-between items-start">
              <div>
                <span className="text-xs font-sans font-bold tracking-[0.15em] text-crimson uppercase mb-4 block">El Reto a Debatir</span>
                <h2 className="text-4xl lg:text-5xl font-display font-medium text-ink leading-[1.2] max-w-4xl text-balance">
                  {activeChapter.challenge}
                </h2>
              </div>
              
              {activeChapter.fullText && (
                <button 
                  onClick={() => setShowText(!showText)}
                  className="px-6 py-3 border border-ink text-ink font-sans text-xs tracking-widest uppercase rounded-sm hover:bg-ink hover:text-parchment transition-colors shadow-sm ml-8 flex-shrink-0"
                >
                  {showText ? 'Volver al Ágora' : 'Leer Texto Base'}
                </button>
              )}
            </header>

            <div className="flex-1 overflow-y-auto px-12 py-16 lg:px-24 scroll-smooth">
              {showText ? (
                <div className="max-w-3xl mx-auto pb-12">
                  <div className="bg-parchment/95 border border-stone-300 shadow-md p-10 lg:p-14 rounded-sm text-ink font-serif text-lg leading-loose">
                    
                    {activeChapter.fullText && (
                      <LectorVoz texto={activeChapter.fullText} />
                    )}
                    
                    <hr className="my-6 border-stone-300/50" />

                    {activeChapter.fullText?.split('\n').map((paragraph, idx) => (
                      <p key={idx} className={paragraph.trim() === '' ? 'h-4' : 'mb-6 text-justify'}>
                        {/* Se conecta la función para abrir el modal al detectar un clic */}
                        <TextoEnriquecido 
                          texto={paragraph} 
                          onTermClick={setReferenciaAbierta} 
                        />
                      </p>
                    ))}
                  </div>
                </div>
              ) : (
                <div className="max-w-3xl mx-auto space-y-12 pb-12">
                  {messages.filter(m => m.role !== 'system').map((msg, i) => (
                    <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                      {msg.role === 'user' ? (
                        <div className="max-w-xl bg-white border border-stone-300 text-ink px-8 py-5 rounded-sm shadow-md font-sans font-light">
                          {msg.content}
                        </div>
                      ) : (
                        <div className="max-w-2xl bg-parchment/95 border-l-4 border-crimson pl-8 pr-6 py-6 relative shadow-md rounded-r-sm">
                          <div className="absolute -left-3 top-6 w-6 h-6 rounded-sm border border-stone-400 text-stone-500 flex items-center justify-center bg-parchment-dark shadow-sm">
                            <span className="font-display text-xs italic">Φ</span>
                          </div>
                          <p className="font-serif text-xl leading-loose text-ink">
                            {msg.content}
                          </p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>

            {!showText && (
              <footer className="p-8 lg:px-24 bg-gradient-to-t from-parchment via-parchment/95 to-transparent pb-12 relative z-10">
                <form onSubmit={handleSendMessage} className="max-w-3xl mx-auto relative group">
                  <div className="absolute inset-0 bg-white shadow-lg shadow-stone-200/50 rounded-sm transform translate-y-1 translate-x-1 border border-stone-200"></div>
                  <input
                    type="text"
                    value={inputValue}
                    onChange={(e) => setInputValue(e.target.value)}
                    placeholder="Redacta tu argumento aquí..."
                    className="w-full relative bg-white border border-stone-300 rounded-sm pl-8 pr-20 py-5 font-serif italic text-lg text-ink focus:outline-none focus:ring-1 focus:ring-crimson transition-all"
                  />
                  <button 
                    type="submit" 
                    disabled={!inputValue.trim()}
                    className="absolute right-4 top-1/2 -translate-y-1/2 px-4 py-2 bg-ink text-parchment font-sans text-xs tracking-widest uppercase rounded-sm hover:bg-crimson disabled:opacity-30 disabled:hover:bg-ink transition-colors"
                  >
                    Exponer
                  </button>
                </form>
              </footer>
            )}
          </>
        ) : (
          <div className="flex-1 flex items-center justify-center text-center px-6 relative">
            <div className="absolute inset-0 bg-ink/75 backdrop-blur-[2px]"></div>
            
            <div className="max-w-md relative z-10">
              <div className="w-16 h-16 mx-auto border border-parchment/30 rounded-sm transform rotate-45 flex items-center justify-center mb-8 bg-ink/40 backdrop-blur-md shadow-2xl">
                <div className="transform -rotate-45 text-parchment font-display text-2xl">Φ</div>
              </div>
              <h2 className="font-display text-4xl font-medium text-parchment mb-4 drop-shadow-lg">
                El Ágora aguarda
              </h2>
              <p className="text-parchment-dark font-serif italic text-xl leading-relaxed drop-shadow-md">
                Abre uno de los retos en el índice lateral para comenzar a tejer tus propios argumentos.
              </p>
            </div>
          </div>
        )}
      </main>

      {/* Renderizado condicional del Modal de profundización */}
      {referenciaAbierta && (
        <ModalReferencia 
          data={referenciaAbierta} 
          onClose={() => setReferenciaAbierta(null)} 
        />
      )}

    </div>
  );
}
</file>

